 mod bitstream;
 mod cabac;
+
+type CancelCheck = std::sync::Arc<dyn Fn() -> bool + Send + Sync>;
+
+thread_local! {
+    static CANCEL_CHECK: std::cell::RefCell<Option<CancelCheck>> = const { std::cell::RefCell::new(None) };
+}
+
+/// Supply a cooperative cancellation check for encoding in this scope.
+pub fn with_cancel_check<T>(
+    check: impl Fn() -> bool + Send + Sync + 'static,
+    encode: impl FnOnce() -> T,
+) -> T {
+    struct Restore(Option<CancelCheck>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            CANCEL_CHECK.with(|check| check.replace(self.0.take()));
+        }
+    }
+    let _restore = Restore(CANCEL_CHECK.with(|slot| slot.replace(Some(std::sync::Arc::new(check)))));
+    encode()
+}
+
+fn current_cancel_check() -> Option<CancelCheck> {
+    CANCEL_CHECK.with(|check| check.borrow().clone())
+}
+
+fn check_cancelled(check: Option<&CancelCheck>) -> Result<(), EncodeError> {
+    if check.is_some_and(|check| check()) {
+        return Err(EncodeError::Interrupted);
+    }
+    Ok(())
+}
 
