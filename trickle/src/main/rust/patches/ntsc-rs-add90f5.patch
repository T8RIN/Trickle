+use std::{cell::RefCell, sync::Arc};
+
+type Check = Arc<dyn Fn() -> bool + Send + Sync>;
+
+thread_local! {
+    static CHECK: RefCell<Option<Check>> = const { RefCell::new(None) };
+}
+
+fn current_check() -> Option<Check> {
+    CHECK.with(|slot| slot.borrow().clone())
+}
+
+pub(crate) fn cancelled() -> bool {
+    CHECK.with(|slot| slot.borrow().as_ref().is_some_and(|check| check()))
+}
+
+fn with_check<T>(check: Option<Check>, run: impl FnOnce() -> T) -> T {
+    struct Restore(Option<Check>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            CHECK.with(|slot| slot.replace(self.0.take()));
+        }
+    }
+    let _restore = Restore(CHECK.with(|slot| slot.replace(check)));
+    run()
+}
+
+/// Apply the effect with a cooperative cancellation check shared with its workers.
+/// The caller must discard the output if cancellation was requested.
+pub fn with_cancel_check<T>(
+    check: impl Fn() -> bool + Send + Sync + 'static,
+    run: impl FnOnce() -> T,
+) -> T {
+    with_check(Some(Arc::new(check)), run)
+}
